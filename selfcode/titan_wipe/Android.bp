
cc_binary {
    name: "titan_wipe",
    srcs: ["titan_wipe.cpp"],
    static_libs: [
        "libnos_citadel_for_recovery",
        "libnos_for_recovery",
    ],
    shared_libs: [
        "libbase",
        "liblog",
    ],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
        "-Wno-zero-length-array",
    ],
}
