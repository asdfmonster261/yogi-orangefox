# twrp.flags — Tensor G6 (malibu / yogi, Pixel 11 Pro Fold) | UFS @ 3c2d0000
# Structure mirrors twrp.flags; UFS controller 3c2d0000, USB OTG via a210000.dwc3.
#
# The bootloader chain (abl, bl31, tzsw, pvmfw, gsa_bl1, gsa_fw, cap, cpm, dbc,
# dbl, dram_init_*, dram_phy, gc, gdmc) is deliberately NOT listed here: writing
# any of it risks an unrecoverable brick, and recovery never needs to. They stay
# reachable from a shell if ever required, just not one-tap flashable in the UI.
#
# mount point         fstype  device                                                             flags

# ============================================================
# 1. Dynamic logical partitions (in super, A/B via slotselect)
# ============================================================
/system              ext4    /dev/block/mapper/system                                           flags=display="System";logical;backup=1;slotselect
/system_ext          ext4    /dev/block/mapper/system_ext                                       flags=display="System Ext";logical;backup=1;slotselect
/system_dlkm         ext4    /dev/block/mapper/system_dlkm                                      flags=display="System DLKM (GKI kernel modules)";logical;backup=1;slotselect
/product             ext4    /dev/block/mapper/product                                          flags=display="Product";logical;backup=1;slotselect
/vendor              ext4    /dev/block/mapper/vendor                                            flags=display="Vendor";logical;backup=1;slotselect
/vendor_dlkm         ext4    /dev/block/mapper/vendor_dlkm                                      flags=display="Vendor DLKM (device kernel modules)";logical;backup=1;slotselect

# ============================================================
# 2. Metadata (FBE key wrapping) + Internal Storage
# ============================================================
/metadata            f2fs    /dev/block/platform/3c2d0000.ufs/by-name/metadata                  flags=display="Metadata (FBE crypto info)";backup=1;wipeingui;wrappedkey
/storage             ext4    /data/media/0                                                      flags=display="Internal Storage (Files / sdcard)";backup=1;usermrf;fsflags="bind";removable

# ============================================================
# 3. Boot images (A/B slotted, raw images)
# ============================================================
/boot                emmc    /dev/block/platform/3c2d0000.ufs/by-name/boot                      flags=slotselect;display="Boot Image";backup=1;flashimg=1
/init_boot           emmc    /dev/block/platform/3c2d0000.ufs/by-name/init_boot                 flags=slotselect;display="Init Boot (Generic Ramdisk)";backup=1;flashimg=1
/vendor_boot         emmc    /dev/block/platform/3c2d0000.ufs/by-name/vendor_boot                flags=slotselect;display="Vendor Boot (OrangeFox Recovery)";backup=1;flashimg=1
/vendor_kernel_boot  emmc    /dev/block/platform/3c2d0000.ufs/by-name/vendor_kernel_boot         flags=slotselect;display="Vendor Kernel Boot (GKI modules)";backup=1;flashimg=1
/dtbo                emmc    /dev/block/platform/3c2d0000.ufs/by-name/dtbo                      flags=slotselect;display="DTBO (Device Tree Overlay)";backup=1;flashimg=1

# ============================================================
# 4. Verified Boot metadata (A/B slotted)
# ============================================================
/vbmeta              emmc    /dev/block/platform/3c2d0000.ufs/by-name/vbmeta                    flags=slotselect;display="VBMeta (Verified Boot)";backup=1;flashimg=1
/vbmeta_system       emmc    /dev/block/platform/3c2d0000.ufs/by-name/vbmeta_system             flags=slotselect;display="VBMeta System";backup=1;flashimg=1
/vbmeta_vendor       emmc    /dev/block/platform/3c2d0000.ufs/by-name/vbmeta_vendor             flags=slotselect;display="VBMeta Vendor";backup=1;flashimg=1

# ============================================================
# 5. Modem / Radio firmware (A/B slotted)
# ============================================================
/modem               emmc    /dev/block/platform/3c2d0000.ufs/by-name/modem                     flags=slotselect;display="Modem (Radio Firmware)";backup=1;flashimg=1

# ============================================================
# 6. Misc / OTA state
# ============================================================
/misc                emmc    /dev/block/platform/3c2d0000.ufs/by-name/misc                      flags=display="Misc (OTA state, bootloader messages)";backup=1;flashimg=1

# ============================================================
# 7. External Storage (USB OTG)
# ============================================================
/usb_otg             auto    /dev/block/sdd1                                                    flags=display="USB OTG (External Drive)";storage;wipeingui;removable;fsflags="utf8"
