# init.recovery.kodiak.rc - Pixel 11 Pro XL (kodiak), Tensor G6 stub.
# Loaded by init when ro.hardware=kodiak. All actual init is in init.recovery.pixel_common.rc.
import /init.recovery.pixel_common.rc

# The recovery health HAL (android.hardware.health-service.malibu_recovery) ships
# without its android.hardware.health-V5-ndk.so dependency, so it fails to link and
# init respawns it every 5s. Recovery needs no battery HAL; override it disabled.
service vendor.health-malibu /system/bin/hw/android.hardware.health-service.malibu_recovery
    class hal
    seclabel u:r:hal_health_default:s0
    user system
    group system
    capabilities WAKE_ALARM BLOCK_SUSPEND
    file /dev/kmsg w
    disabled
    override
